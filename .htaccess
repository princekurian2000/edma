<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Exclude existing PHP files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
  RewriteRule ^ - [L]

  # Main SPA redirect rule
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
